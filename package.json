{
	"name": "@sapphire/framework",
	"version": "5.5.1",
	"description": "Discord bot framework built for advanced and amazing bots.",
	"type": "module",
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		"types": "./dist/index.d.mts",
		"import": "./dist/index.mjs"
	},
	"author": "@sapphire",
	"license": "MIT",
	"scripts": {
		"lint": "eslint src tests --fix",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"update": "yarn upgrade-interactive",
		"typecheck": "tsc -p tsconfig.eslint.json",
		"build": "tsdown",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run",
		"prepack": "yarn build"
	},
	"dependencies": {
		"@discordjs/builders": "^1.15.0",
		"@sapphire/discord-utilities": "^4.0.0",
		"@sapphire/discord.js-utilities": "^7.3.3",
		"@sapphire/lexure": "^1.1.12",
		"@sapphire/pieces": "^5.0.0",
		"@sapphire/ratelimits": "^2.4.11",
		"@sapphire/result": "^2.8.0",
		"@sapphire/stopwatch": "^1.5.4",
		"@sapphire/utilities": "^3.18.3",
		"discord-api-types": "^0.38.60"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@favware/cliff-jumper": "^6.1.0",
		"@favware/npm-deprecate": "^2.0.0",
		"@sapphire/eslint-config": "^6.0.0",
		"@sapphire/node-utilities": "^1.0.2",
		"@sapphire/prettier-config": "^2.0.0",
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^24.19.2",
		"@types/ws": "^8.18.2",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"@vitest/coverage-v8": "^5.1.1",
		"cz-conventional-changelog": "^3.3.0",
		"discord.js": "^14.28.1",
		"eslint": "^10.15.0",
		"lint-staged": "^17.6.1",
		"prettier": "^3.10.1",
		"tsdown": "^0.23.7",
		"typescript": "~6.0.3",
		"unplugin-replace": "^0.9.1",
		"vite": "^7.3.7",
		"vitest": "^5.1.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sapphiredev/framework.git"
	},
	"files": [
		"dist/"
	],
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=11.0.0"
	},
	"keywords": [
		"bot",
		"typescript",
		"ts",
		"yarn",
		"discord",
		"sapphire",
		"standalone"
	],
	"bugs": {
		"url": "https://github.com/sapphiredev/framework/issues"
	},
	"homepage": "https://www.sapphirejs.dev",
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write",
		"*.{mjs,js,ts}": "eslint --fix"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"prettier": "@sapphire/prettier-config",
	"packageManager": "yarn@4.18.1"
}
